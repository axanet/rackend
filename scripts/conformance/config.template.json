{
  "alias": "rackend",
  "description": "rackend OIDC provider",
  "server": {
    "discoveryUrl": "https://rackend.test/.well-known/openid-configuration",
    "login_hint": "conformance@example.com"
  },
  "client": {
    "client_id": "{CLIENT1_ID}",
    "client_secret": "{CLIENT1_SECRET}"
  },
  "client_secret_post": {
    "client_id": "{CLIENT1_ID}",
    "client_secret": "{CLIENT1_SECRET}"
  },
  "client2": {
    "client_id": "{CLIENT2_ID}",
    "client_secret": "{CLIENT2_SECRET}"
  },
  "browser": [
    {
      "match": "https://rackend.test/oauth2/authorize*",
      "tasks": [
        {
          "task": "Login",
          "optional": true,
          "match": "https://rackend.test/auth/login*",
          "commands": [
            [
              "text",
              "name",
              "email",
              "conformance@example.com",
              "optional"
            ],
            [
              "text",
              "name",
              "password",
              "conformance user password",
              "optional"
            ],
            [
              "click",
              "id",
              "password-submit"
            ]
          ]
        },
        {
          "task": "Verify Complete",
          "match": "*/test/*/callback*",
          "commands": [
            [
              "wait",
              "id",
              "submission_complete",
              10
            ]
          ]
        }
      ]
    }
  ],
  "override": {
    "oidcc-prompt-login": {
      "browser": [
        {
          "comment": "screenshot of the login page during the second authorization",
          "match": "https://rackend.test/oauth2/authorize*",
          "tasks": [
            {
              "task": "Login",
              "optional": true,
              "match": "https://rackend.test/auth/login*",
              "commands": [
                [
                  "wait",
                  "xpath",
                  "//*",
                  10,
                  "Sign in",
                  "update-image-placeholder-optional"
                ],
                [
                  "text",
                  "name",
                  "email",
                  "conformance@example.com",
                  "optional"
                ],
                [
                  "text",
                  "name",
                  "password",
                  "conformance user password",
                  "optional"
                ],
                [
                  "click",
                  "id",
                  "password-submit"
                ]
              ]
            },
            {
              "task": "Verify Complete",
              "match": "*/test/*/callback*",
              "commands": [
                [
                  "wait",
                  "id",
                  "submission_complete",
                  10
                ]
              ]
            }
          ]
        }
      ]
    },
    "oidcc-max-age-1": {
      "browser": [
        {
          "comment": "screenshot of the login page during the second authorization",
          "match": "https://rackend.test/oauth2/authorize*",
          "tasks": [
            {
              "task": "Login",
              "optional": true,
              "match": "https://rackend.test/auth/login*",
              "commands": [
                [
                  "wait",
                  "xpath",
                  "//*",
                  10,
                  "Sign in",
                  "update-image-placeholder-optional"
                ],
                [
                  "text",
                  "name",
                  "email",
                  "conformance@example.com",
                  "optional"
                ],
                [
                  "text",
                  "name",
                  "password",
                  "conformance user password",
                  "optional"
                ],
                [
                  "click",
                  "id",
                  "password-submit"
                ]
              ]
            },
            {
              "task": "Verify Complete",
              "match": "*/test/*/callback*",
              "commands": [
                [
                  "wait",
                  "id",
                  "submission_complete",
                  10
                ]
              ]
            }
          ]
        }
      ]
    },
    "oidcc-ensure-registered-redirect-uri": {
      "browser": [
        {
          "comment": "expect an immediate error page",
          "match": "https://rackend.test/oauth2/authorize*",
          "tasks": [
            {
              "task": "Expect an error page",
              "match": "https://rackend.test/oauth2/authorize*",
              "commands": [
                [
                  "wait",
                  "xpath",
                  "//*",
                  10,
                  "Something went wrong",
                  "update-image-placeholder"
                ]
              ]
            }
          ]
        }
      ]
    },
    "oidcc-ensure-redirect-uri-in-authorization-request": {
      "browser": [
        {
          "comment": "expect an immediate error page",
          "match": "https://rackend.test/oauth2/authorize*",
          "tasks": [
            {
              "task": "Expect an error page",
              "match": "https://rackend.test/oauth2/authorize*",
              "commands": [
                [
                  "wait",
                  "xpath",
                  "//*",
                  10,
                  "Something went wrong",
                  "update-image-placeholder"
                ]
              ]
            }
          ]
        }
      ]
    },
    "oidcc-ensure-request-object-with-redirect-uri": {
      "browser": [
        {
          "comment": "expect an immediate error page",
          "match": "https://rackend.test/oauth2/authorize*",
          "tasks": [
            {
              "task": "Expect an error page",
              "match": "https://rackend.test/oauth2/authorize*",
              "commands": [
                [
                  "wait",
                  "xpath",
                  "//*",
                  10,
                  "Something went wrong",
                  "update-image-placeholder"
                ]
              ]
            }
          ]
        }
      ]
    }
  }
}
